{
  "experiment_name": "camouflage_concealment_segmentation",
  "model": {
    "architecture": "EdgeGuidedUNet",
    "in_channels": 3,
    "out_channels": 1,
    "edge_supervision": true
  },
  "dataset": {
    "train_source": "COD10K_Train + CAMO_Train",
    "val_source": "COD10K_Test + CAMO_Test",
    "benchmark_evaluation": "SYNTHETIC_CONCEALMENT",
    "img_size": 512
  },
  "training": {
    "batch_size": 4,
    "num_workers": 2,
    "num_epochs": 6,
    "lr": 3e-4,
    "weight_decay": 1e-4,
    "amp_fp16": true,
    "seed": 42
  },
  "checkpoint": {
    "dir": "checkpoints",
    "best_filename": "best_camouflage_model.pth"
  }
}
